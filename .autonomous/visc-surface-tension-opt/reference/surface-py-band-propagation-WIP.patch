+# --- Surface-tension SDF narrow-band construction modes -------------------
+#
+# With surface tension enabled the solver-grid SDF must carry valid
+# union-of-spheres distances out to ``support_voxels`` so the capillary
+# normal/curvature stencil never reads truncated values.  Three ways of
+# paying for that band are implemented; they differ only in cost, and the
+# non-default ones exist so a before/after benchmark can run from one binary.
+#
+#   "legacy"    - the original behaviour: every particle atomically writes the
+#                 full (2R+1)^3 cube for the band radius R.
+#   "splat"     - identical output, but the cube is culled to the ball of
+#                 radius (far_distance + particle_radius).  Cells outside that
+#                 ball can only produce distances >= far_distance, which can
+#                 never win the atomic_min against a field initialised to
+#                 exactly far_distance, so the result is bit-identical.
+#   "propagate" - default.  Splat only the small radius that the particle
+#                 support actually justifies, recording the closest particle
+#                 per seeded voxel, then reconstruct the band by propagating
+#                 those closest points outward over the active voxels.  Work
+#                 scales with active voxels instead of particles x R^3.
+SDF_BAND_MODE_PROPAGATE = "propagate"
+SDF_BAND_MODE_SPLAT = "splat"
+SDF_BAND_MODE_LEGACY = "legacy"
+SDF_BAND_MODES = (
+    SDF_BAND_MODE_PROPAGATE, SDF_BAND_MODE_SPLAT, SDF_BAND_MODE_LEGACY)
+DEFAULT_SDF_BAND_MODE = SDF_BAND_MODE_PROPAGATE
+
+# Sentinel used as the "no closest particle yet" distance while propagating.
+SDF_PROPAGATION_FAR = 1.0e30
+# Half the sentinel: any distance at or above this means "unseeded".
+SDF_PROPAGATION_FAR_TEST = 0.5 * SDF_PROPAGATION_FAR
+# Slack (in voxels) added to the analytic ball-cull radius so float rounding
+# can never discard a cell that would have lowered the field.  The float32
+# error on these coordinates is ~1e-5 voxels; 0.01 voxels is three orders of
+# magnitude of headroom and costs <1 % extra cells.
+SDF_CULL_SLACK_VOXELS = 0.01
+_INT32_MAX = 2147483647
+
