+    @staticmethod
+    def band_propagation_passes(cull_voxels, seed_splat):
+        """Passes needed to carry closest points out to ``cull_voxels``.
+
+        The seed splat writes the full cube of half-width ``seed_splat``
+        centred on the particle's own cell, so every voxel whose nearest
+        particle is within ``seed_splat - 1`` voxels is seeded exactly (a
+        particle sits at most one cell away from its own cell centre on each
+        axis).  Each propagation pass carries a closest point one voxel
+        further in the Chebyshev metric, which covers at least one voxel of
+        Euclidean reach, so this many passes reach the cull radius.
+        """
+
+        reach = float(cull_voxels) - (max(1, int(seed_splat)) - 1)
+        return max(0, int(math.ceil(reach - 1.0e-9)))
+
+    def _launch_sdf_field(self, grid, sdf, tmp, nvox, positions, h, radius,
+                          seed_splat, band_splat, far_distance):
+        """Fill ``sdf`` with the union-of-spheres field clamped at far_distance.
+
+        ``band_splat`` is the radius the capillary support band requires;
+        ``seed_splat`` is the radius the particle support itself justifies.
+        When they differ the band is reconstructed by closest-point
+        propagation instead of by redundant per-particle atomic writes.
+        """
+
+        solver = self.solver
+        device = solver.device
+        mode = self.band_mode()
+        # No cell farther than this from a particle can lower the field below
+        # far_distance, so culling to it leaves the result bit-identical.
+        cull_world = far_distance + radius + SDF_CULL_SLACK_VOXELS * h
+        cull_voxels = cull_world / h
+        use_propagation = (
+            mode == SDF_BAND_MODE_PROPAGATE and int(band_splat) > int(seed_splat))
+        cull = -1.0 if mode == SDF_BAND_MODE_LEGACY else cull_world
+        if not use_propagation:
+            wp.launch(
+                k_surface_sdf_reset, dim=nvox,
+                inputs=[sdf.data, grid.num_leaves, far_distance], device=device)
+            wp.launch(
+                k_build_surface_sdf, dim=solver._np_dim(),
+                inputs=[positions, solver.particles.count, grid.leaf_table,
+                        grid.voxels_dim, grid.leaves_dim, grid.origin, h,
+                        radius, int(band_splat), cull],
+                outputs=[sdf.data], device=device)
+            self.last_sdf_band = {
+                "mode": mode, "seed_splat": int(band_splat),
+                "band_splat": int(band_splat), "passes": 0,
+                "cull_voxels": (-1.0 if cull <= 0.0 else cull_voxels)}
+            return sdf
+
+        passes = self.band_propagation_passes(cull_voxels, seed_splat)
+        self._ensure_band_buffers(len(sdf.data))
+        closest, cp_a, cp_b = (
+            self._band_closest, self._band_cp_a, self._band_cp_b)
+        # Seed: exact union-of-spheres distance plus the argmin particle, over
