+        wp.launch(
+            k_surface_sdf_reset, dim=nvox,
+            inputs=[sdf.data, grid.num_leaves, SDF_PROPAGATION_FAR],
+            device=device)
+        wp.launch(
+            k_surface_band_index_reset, dim=nvox,
+            inputs=[closest, grid.num_leaves], device=device)
+        wp.launch(
+            k_build_surface_sdf, dim=solver._np_dim(),
+            inputs=[positions, solver.particles.count, grid.leaf_table,
+                    grid.voxels_dim, grid.leaves_dim, grid.origin, h, radius,
+                    int(seed_splat), -1.0],
+            outputs=[sdf.data], device=device)
+        wp.launch(
+            k_seed_surface_sdf_closest, dim=solver._np_dim(),
+            inputs=[positions, solver.particles.count, grid.leaf_table,
+                    grid.voxels_dim, grid.leaves_dim, grid.origin, h, radius,
+                    int(seed_splat), sdf.data],
+            outputs=[closest], device=device)
+        wp.launch(
+            k_gather_surface_band_points, dim=nvox,
+            inputs=[closest, positions, grid.num_leaves], outputs=[cp_a],
+            device=device)
+        for _ in range(passes):
+            wp.launch(
+                k_propagate_surface_sdf_band, dim=nvox,
+                inputs=[sdf.data, cp_a, grid.leaf_table, grid.leaf_coords,
+                        grid.voxels_dim, grid.leaves_dim, grid.num_leaves,
+                        grid.origin, h, radius],
+                outputs=[tmp.data, cp_b], device=device)
+            sdf.data, tmp.data = tmp.data, sdf.data
+            cp_a, cp_b = cp_b, cp_a
