+# Surface-tension narrow band: closest-point seeding and propagation.
+#
+# The capillary stencil needs valid distances several voxels beyond the liquid,
+# but those values are a distance field, not particle data. Splatting each
+# particle across the whole band costs O(particles * band^3) atomic writes; the
+# band is instead reconstructed by carrying the closest particle outward across
+# the active voxels, which costs O(active voxels * passes).
+
+
+@wp.kernel
+def k_surface_band_index_reset(
+    closest: wp.array(dtype=wp.int32),
+    num_leaves: wp.array(dtype=wp.int32),
+):
+    tid = wp.tid()
+    if tid >= num_leaves[0] * C.LEAF_VOLUME:
+        return
+    closest[tid] = wp.int32(2147483647)
+
+
+@wp.kernel
+def k_seed_surface_sdf_closest(
+    positions: wp.array(dtype=wp.vec3),
+    count: wp.array(dtype=wp.int32),
+    leaf_table: wp.array(dtype=wp.int32),
+    voxels_dim: wp.vec3i,
+    leaves_dim: wp.vec3i,
+    origin: wp.vec3,
+    voxel_size: float,
+    particle_radius: float,
+    splat_radius_voxels: int,
+    sdf: wp.array(dtype=float),
+    closest: wp.array(dtype=wp.int32),
+):
+    """Record which particle produced each seeded voxel's distance.
+
+    Runs the same cube loop and the same distance expression as
+    ``k_build_surface_sdf``, so the winning particle reproduces the stored
+    minimum bit-for-bit. Ties resolve to the lowest particle index, which makes
+    the seeding deterministic regardless of atomic ordering.
+    """
+    tid = wp.tid()
+    if tid >= count[0]:
+        return
+    p = positions[tid]
+    vp = world_to_voxel(p, origin, voxel_size)
+    ci = int(wp.floor(vp[0]))
+    cj = int(wp.floor(vp[1]))
+    ck = int(wp.floor(vp[2]))
+    r = splat_radius_voxels
+    for dk in range(-r, r + 1):
+        for dj in range(-r, r + 1):
+            for di in range(-r, r + 1):
+                ijk = wp.vec3i(ci + di, cj + dj, ck + dk)
+                flat = voxel_flat_index(leaf_table, voxels_dim, leaves_dim, ijk)
+                if flat < 0:
+                    continue
+                cw = voxel_center_world(ijk, origin, voxel_size)
+                d = wp.length(cw - p) - particle_radius
+                if d <= sdf[flat]:
+                    wp.atomic_min(closest, flat, tid)
+
+
+@wp.kernel
+def k_gather_surface_band_points(
+    closest: wp.array(dtype=wp.int32),
+    positions: wp.array(dtype=wp.vec3),
+    num_leaves: wp.array(dtype=wp.int32),
+    points: wp.array(dtype=wp.vec3),
+):
+    tid = wp.tid()
+    if tid >= num_leaves[0] * C.LEAF_VOLUME:
+        return
+    idx = closest[tid]
+    if idx >= 0 and idx < wp.int32(2147483647):
+        points[tid] = positions[idx]
+    else:
+        points[tid] = wp.vec3(0.0, 0.0, 0.0)
+
+
+@wp.kernel
+def k_propagate_surface_sdf_band(
+    src_sdf: wp.array(dtype=float),
+    src_points: wp.array(dtype=wp.vec3),
+    leaf_table: wp.array(dtype=wp.int32),
+    leaf_coords: wp.array(dtype=wp.vec3i),
+    voxels_dim: wp.vec3i,
+    leaves_dim: wp.vec3i,
+    num_leaves: wp.array(dtype=wp.int32),
+    origin: wp.vec3,
+    voxel_size: float,
+    particle_radius: float,
+    dst_sdf: wp.array(dtype=float),
+    dst_points: wp.array(dtype=wp.vec3),
+):
+    """One outward pass of closest-point propagation over the active voxels.
+
+    Every candidate distance is recomputed from this voxel's own centre to the
+    neighbour's closest particle, so the field stays an exact Euclidean
+    union-of-spheres distance to whichever particle it has found so far. The
+    value can therefore only ever be an upper bound of the true field, never
+    an underestimate.
+    """
+    tid = wp.tid()
+    if tid >= num_leaves[0] * C.LEAF_VOLUME:
+        return
+    ijk = voxel_coord_of_flat(leaf_coords, tid)
+    cw = voxel_center_world(ijk, origin, voxel_size)
+    best = src_sdf[tid]
+    best_point = src_points[tid]
+    for dk in range(-1, 2):
+        for dj in range(-1, 2):
+            for di in range(-1, 2):
+                if di == 0 and dj == 0 and dk == 0:
+                    continue
+                n = wp.vec3i(ijk[0] + di, ijk[1] + dj, ijk[2] + dk)
+                flat = voxel_flat_index(leaf_table, voxels_dim, leaves_dim, n)
+                if flat < 0:
+                    continue
+                if src_sdf[flat] >= 5.0e29:
+                    continue
+                cand = src_points[flat]
+                d = wp.length(cw - cand) - particle_radius
+                if d < best:
+                    best = d
+                    best_point = cand
+    dst_sdf[tid] = best
+    dst_points[tid] = best_point
+
+
+@wp.kernel
+def k_clamp_surface_sdf(
+    sdf: wp.array(dtype=float),
+    num_leaves: wp.array(dtype=wp.int32),
+    limit: float,
+):
+    tid = wp.tid()
+    if tid >= num_leaves[0] * C.LEAF_VOLUME:
+        return
+    sdf[tid] = wp.min(sdf[tid], limit)
+
+
+register_fn(k_propagate_surface_sdf_band, "fluidSimPropagateSurfaceSdfBand",
+            notes="Closest-point band extension for the capillary SDF support.")
+
