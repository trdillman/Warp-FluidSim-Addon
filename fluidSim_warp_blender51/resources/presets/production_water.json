{
  "schema_version": 1,
  "id": "production_water",
  "name": "Production Water",
  "description": "General final-quality water with a finer render surface and resumable cache defaults. Changes solver state and requires Reset.",
  "expected_scale": "1 Blender unit = 1 metre; domains roughly 0.5-10 metres",
  "performance_cost": "High",
  "requires_reset": true,
  "source_version": "1.0.250",
  "settings": {
    "voxel_size": 0.05,
    "leaf_capacity": 16384,
    "max_particles": 3000000,
    "auto_grow_particles": true,
    "particles_per_voxel": 8,
    "sample_type": "FLIP",
    "flip_ratio": 0.97,
    "trace_mode": "RK3",
    "cfl": 0.8,
    "max_substeps": 8,
    "pressure_solver": "PCG",
    "pressure_iterations": 300,
    "pressure_tolerance": 1e-05,
    "surface_tension_enabled": false,
    "surface_enabled": true,
    "surface_resolution_mode": "MULTIPLIER",
    "surface_resolution_multiplier": 2.0,
    "surface_smooth_iterations": 2,
    "surface_smooth_strength": 0.55,
    "surface_update_cadence": "FRAME",
    "live_surface_publish_cadence": 1,
    "whitewater_enabled": false,
    "cache_compress": false,
    "checkpoint_interval": 1
  }
}
