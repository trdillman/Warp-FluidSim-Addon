{
  "schema_version": 1,
  "id": "stylized_high_tension",
  "name": "Stylized High Tension",
  "description": "Exaggerated cohesive liquid for beads and compact droplets. Uses a nonphysical 0.25 N/m coefficient and requires Reset.",
  "expected_scale": "1 Blender unit = 1 metre; stylized beads and streams roughly 0.03-1 metre",
  "performance_cost": "Very high; stronger capillarity and fine resolution commonly require many substeps",
  "requires_reset": true,
  "source_version": "1.0.250",
  "settings": {
    "voxel_size": 0.04,
    "leaf_capacity": 16384,
    "max_particles": 3000000,
    "auto_grow_particles": true,
    "particles_per_voxel": 8,
    "sample_type": "FLIP",
    "flip_ratio": 0.96,
    "trace_mode": "RK3",
    "cfl": 0.75,
    "min_substeps": 2,
    "max_substeps": 16,
    "pressure_solver": "PCG",
    "pressure_iterations": 400,
    "pressure_tolerance": 5e-06,
    "surface_tension_enabled": true,
    "surface_tension_coefficient": 0.25,
    "surface_tension_density": 1000.0,
    "surface_tension_band_voxels": 2.0,
    "surface_tension_safety": 0.4,
    "surface_tension_smoothing_iterations": 2,
    "surface_enabled": true,
    "surface_resolution_mode": "MULTIPLIER",
    "surface_resolution_multiplier": 2.0,
    "particle_radius_scale": 1.3,
    "surface_smooth_iterations": 2,
    "surface_smooth_strength": 0.6,
    "surface_update_cadence": "FRAME",
    "whitewater_enabled": false,
    "cache_compress": false,
    "checkpoint_interval": 1
  }
}
