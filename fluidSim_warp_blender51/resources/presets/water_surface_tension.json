{
  "schema_version": 1,
  "id": "water_surface_tension",
  "name": "Water Surface Tension",
  "description": "Production water with physical-scale capillarity enabled at 0.072 N/m. Changes solver allocation and requires Reset.",
  "expected_scale": "1 Blender unit = 1 metre; droplets and streams roughly 0.02-2 metres",
  "performance_cost": "High; capillary stability can increase frame substeps at fine voxel sizes",
  "requires_reset": true,
  "source_version": "1.0.250",
  "settings": {
    "voxel_size": 0.04,
    "leaf_capacity": 16384,
    "max_particles": 3000000,
    "auto_grow_particles": true,
    "particles_per_voxel": 8,
    "sample_type": "FLIP",
    "flip_ratio": 0.97,
    "trace_mode": "RK3",
    "cfl": 0.8,
    "min_substeps": 1,
    "max_substeps": 12,
    "pressure_solver": "PCG",
    "pressure_iterations": 350,
    "pressure_tolerance": 1e-05,
    "surface_tension_enabled": true,
    "surface_tension_coefficient": 0.072,
    "surface_tension_density": 1000.0,
    "surface_tension_band_voxels": 1.5,
    "surface_tension_safety": 0.5,
    "surface_tension_smoothing_iterations": 1,
    "surface_enabled": true,
    "surface_resolution_mode": "MULTIPLIER",
    "surface_resolution_multiplier": 2.0,
    "surface_smooth_iterations": 2,
    "surface_smooth_strength": 0.5,
    "surface_update_cadence": "FRAME",
    "whitewater_enabled": false,
    "cache_compress": false,
    "checkpoint_interval": 1
  }
}
