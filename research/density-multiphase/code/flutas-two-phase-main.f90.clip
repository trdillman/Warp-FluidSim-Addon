! Observed two-phase step sequence:
!   call advvof(...)
!   call update_property(... rho1, rho2, mu1, mu2 ...)
!   ! velocity predictor / Runge-Kutta update
!   call grav_tw_src(...)
!   call pres_tw_src(...)
!   call surft_src(...)
!   call solver_gpu(...)
!   call correc(...)

! Finding: the implementation demonstrates an accelerator-resident ordering.
! It uses dense/decomposed arrays and an FFT-oriented pressure path rather than
! the required fixed-tile sparse variable-coefficient architecture.
