KERNEL(idx) void knMapLinearMACGridToVec3_FLIP(...)
{
    if (!ptype || !((*ptype)[idx] & exclude)) {
        const Vec3 v = MACGrid::getInterpolated(grid, parts[idx].pos);
        const Vec3 vOld = MACGrid::getInterpolated(oldVel, parts[idx].pos);
        pvel[idx] = flipRatio * (pvel[idx] + v - vOld)
                   + (Real(1.) - flipRatio) * v;
    }
}

// Inspected functions: knMapLinearVec3ToMACGrid, mapPartsToMAC,
// mapPartsToGrid, knMapLinearMACGridToVec3_PIC,
// knMapLinearMACGridToVec3_FLIP, flipVelocityUpdate.
