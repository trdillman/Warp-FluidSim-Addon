void Foam::solvers::incompressibleVoF::prePredictor()
{
    const dimensionedScalar& rho1 = mixture.rho1();
    const dimensionedScalar& rho2 = mixture.rho2();
    rhoPhi = alphaPhi1*rho1 + alphaPhi2*rho2;
}

void Foam::solvers::incompressibleVoF::pressureCorrector()
{
    incompressiblePressureCorrector();
}

// Evidence: phase-fraction fluxes construct a mass flux before the shared
// incompressible pressure correction.
