void Foam::interfaceProperties::calculateK()
{
    const volVectorField gradAlpha1(fvc::grad(alpha1_));
    surfaceVectorField nHatfv(fvc::interpolate(gradAlpha1));
    correctContactAngle(nHatfv, gradAlpha1);
    nHatf_ = nHatfv & mesh_.Sf();
    K_ = -fvc::div(nHatf_);
}

Foam::tmp<Foam::surfaceScalarField>
Foam::interfaceProperties::surfaceTensionForce() const
{
    return fvc::interpolate(sigmaK())*fvc::snGrad(alpha1_);
}

// Nearby upstream function correctContactAngle() obtains cos(theta), adjusts
// the interface normal at wall patches, then normalizes it.
